<%- include("./partials/header") %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <ul>
            <% projByCat.forEach(proj=>{ %>

                <li>
                    <a href="/project/<%= proj.id %>">
                        <%= proj.service %>
                    </a>
                </li>

                <%})%>
        </ul>
        <% if (user && user.role_name==='admin' ) { %>
            <div class="button-container">
                <a href="/edit-category/<%= categ.category_id %>" class="btn-action">Edit Category</a>
            </div>
            <% } %>
    </main>



    <%- include('./partials/footer') %>