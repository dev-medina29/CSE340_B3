<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>

        <% if (user && user.role_name === 'admin') { %>
            <div class="admin-actions">
                <a href="/users" class="btn">Manage All Users</a>
            </div>
        <% } %>
    </main>

    <%- include('partials/footer') %>