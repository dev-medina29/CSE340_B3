<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>
        <% if (user && user.role_name==='admin' ) { %>
            <div class="button-container">
                <a href="/users" class="btn-action">Manage All Users</a>
            </div>
            <% } %>
                <% if (hasProject) { %>
                    <p> Here are Projects that you volunteer for:</p>
                    <ul>
                        <% listVolProj.forEach(proj=> { %>
                            <li>
                                <%= proj.title %>
                                    <a href="/project/<%= proj.project_id %>/unvolunteer">Not to be Volunteer</a>
                            </li>
                            <% }) %>
                    </ul>
                    <% } else { %>
                        <p>You are not volunteer to any project <a href="/projects">See projects</a></p>
                        <% } %>


    </main>

    <%- include('partials/footer') %>