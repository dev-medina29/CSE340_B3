<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projId %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= projDet.title %>" maxlength="150" required />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="500" required><%= projDet.des %></textarea>
            </div>
            <div class="form-group">
                <label for="location">Location</label>
                <textarea id="location" name="location" maxlength="500" required><%= projDet.location %></textarea>
            </div>
            <div class="form-group">
                <label for="organizationId">Organization</label>
                <select id="organizationId" name="organizationId" required>
                    <option value="">Select an organization</option>
                    <% organizations.forEach(org=> { %>
                        <option value="<%= org.id %>" <% if (org.id===projDet.organization_id) { %>selected<% } %>><%=
                                    org.name %>
                        </option>
                        <% }); %>
                </select>
            </div>
            <div class="form-group">
                <label for="date">Date</label>
                <input type="date" id="date" name="date"
                    value="<%= projDet.date ? (typeof projDet.date === 'string' ? projDet.date.split('T')[0] : new Date(projDet.date).toISOString().split('T')[0]) : new Date().toISOString().split('T')[0] %>"
                    required />
            </div>


            <button type="submit">Update Project</button>
        </form>

    </main>
    <%- include('partials/footer') %>