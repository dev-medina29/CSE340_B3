<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projId %>" method="POST">
            <div class="form-group">
                <label for="title">Project Title</label>
                <input type="text" id="title" name="title" value="<%= ProjDet.title %>" maxlength="150" required />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" maxlength="500" required><%= ProjDet.des %></textarea>
            </div>

            <button type="submit">Update Project</button>
        </form>

    </main>
    <%- include('partials/footer') %>