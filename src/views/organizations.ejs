<%- include('./partials/header') %>
    <main>
        <h1>Organizations</h1>
        <p>Here are a few of our partner organizations:</p>
        <ul class="org-list">
            <% organizations.forEach(org=> { %>
                <li>
                    <img src="/images/<%= org.logo %>" alt="<%= org.name %>">
                    <strong>
                        <a href="/organization/<%= org.organization_id %>">
                            <%= org.name %>
                    </strong></a>: <%= org.email %>
                </li>
                <% }); %>
        </ul>
        <div class="button-container">
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/new-organization" class="btn-action">Add a new organization</a>
                <% } %>
        </div>
    </main>
    <%- include('./partials/footer') %>