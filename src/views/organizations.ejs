<%- include('./partials/header') %>
    <main>
        <h1>Organizations</h1>
        <p>Here are a few of our partner organizations:</p>
        <ul class="org-list">
            <% organizations.forEach(org=> { %>
                <li>
                    <img src="/images/<%= org.logo %>" alt="<%= org.name %>">
                    <strong>
                        <a href="/organization/<%= org.organization_id %>">
                            <%= org.name %>
                    </strong></a>: <%= org.email %>
                </li>
                <% }); %>
        </ul>
        <p><a href="/new-organization">Add a new organization</a></p>
        <p><a href="/edit-organization/<%= organizations.organization_id %>">Edit an organization</a></p>
    </main>
    <%- include('./partials/footer') %>