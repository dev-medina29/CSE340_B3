<%- include('./partials/header') %>
    <main>
        <h1>
            <%= projectDetails.title %>
        </h1>
        <p>
            <%= projectDetails.des %>
        </p>
        <p>
            <%= projectDetails.date.toLocaleDateString("en-US",{ weekday: "short" , day: "2-digit" , month: "2-digit" ,
                year: "numeric" }) %>
        </p>
        <p>
            <%= projectDetails.location %>
        </p>
        <a href="/organization/<%= projectDetails.organization_id%>">
            <%= projectDetails.name %>
        </a>
        <p>This project is in the category:</p>
        <ul>
            <% projById.forEach(proje=> { %>
                <a href="/category/<%= proje.category_id %>">
                    <li>
                        <%= proje.category %>
                    </li>
                </a>
                <% }) %>
        </ul>
    </main>
    <%- include('./partials/footer') %>