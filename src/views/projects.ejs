<%- include('./partials/header') %>
    <main>
        <h1>Projects</h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% fiveProj.forEach(proj=>{ %>
                <li>
                    <%= proj.date.toLocaleDateString("en-US",{ weekday: "short" , day: "2-digit" , month: "2-digit" ,
                        year: "numeric" }) %>: <a href="/project/<%= proj.project_id %>">
                            <%= proj.title %>
                        </a> (<a href="/organization/<%= proj.organization_id %>">
                            <%= proj.name %>
                        </a>)
                </li>
                <%})%>
        </ul>
        <div class="button-container">
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/new-project" class="btn-action">Add a New Service Project</a>
                <% } %>
        </div>
    </main>
    <%- include('./partials/footer') %>