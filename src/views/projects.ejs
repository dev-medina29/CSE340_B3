<%- include('./partials/header') %>
    <main>
        <h1>Projects</h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(proj=>{ %>
                <li>
                    <%= proj.date.toLocaleDateString("en-US",{ weekday: "short" , day: "2-digit" , month: "2-digit" ,
                        year: "numeric" }) %>: <%= proj.title %>(<%= proj.name %>)
                </li>
                <%})%>
        </ul>
    </main>
    <%- include('./partials/footer') %>